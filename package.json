{
    "name": "artemisstore",
    "version": "0.1.6",
    "description": "AppStore for PC",
    "main": "src/main.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "electron .",
        "build": "electron-builder --publish never --dir --windows",
        "createexe": "electron-builder --publish never",
        "sign-and-publish": "electron-builder --publish always",
        "test:security": "node devtools/validate_integrity_security.js",
        "test:winget": "node devtools/validate_winget_manager.js",
        "test:system-info": "node devtools/validate_system_info.js",
        "test:terminal": "node devtools/validate_terminal_branding.js",
        "format": "prettier --write \"**/*.js\" && eslint --fix .",
        "dev:app_editor": "node devtools/application_management/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoixDel/ArtemisStore.git"
    },
    "author": "Noix.Del",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/NoixDel/ArtemisStore/issues"
    },
    "homepage": "https://github.com/NoixDel/ArtemisStore#readme",
    "devDependencies": {
        "cross-env": "^7.0.3",
        "dotenv-cli": "^8.0.0",
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "prettier": "^3.5.3"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "dotenv": "^16.5.0",
        "ejs": "^3.1.10",
        "electron-updater": "^6.6.2",
        "iconv-lite": "^0.7.0",
        "sqlite3": "^6.0.1",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "build": {
        "appId": "artemisstore",
        "productName": "ArtemisStore",
        "asar": true,
        "files": [
            "src/**/*",
            "node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": "ressources",
                "to": "ressources"
            }
        ],
        "publish": {
            "provider": "github",
            "owner": "NoixDel",
            "repo": "ArtemisStore"
        },
        "directories": {
            "buildResources": "build"
        },
        "win": {
            "target": "nsis",
            "icon": "src/renderer/static/img/newfavicon.ico",
            "requestedExecutionLevel": "asInvoker",
            "verifyUpdateCodeSignature": true,
            "signtoolOptions": {
                "publisherName": "Noix.Del",
                "certificateFile": "certificate/MonCertificat.pfx"
            }
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "src/renderer/static/img/newfavicon.ico",
            "uninstallerIcon": "src/renderer/static/img/newfavicon.ico",
            "installerHeaderIcon": "src/renderer/static/img/newfavicon.ico",
            "shortcutName": "ArtemisStore",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "mac": null,
        "linux": null
    }
}
