<%- include('partials/headers', { page_title: "Integrite de votre PC" }) %>

<style>
  .integrity-shell {
    max-width: 1100px;
    margin: 24px auto 48px;
  }

  .integrity-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .integrity-header p {
    margin: 4px 0 0;
    color: #586069;
  }

  .scan-button {
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    background: #0d6efd;
    color: #fff;
    font-weight: 600;
  }

  .scan-button:disabled {
    opacity: 0.65;
  }

  .summary-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .summary-box,
  .check-card {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
  }

  .summary-box {
    padding: 16px;
  }

  .summary-box strong {
    display: block;
    font-size: 24px;
  }

  .checks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .check-card {
    padding: 14px;
  }

  .check-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  .check-title h3 {
    margin: 0;
    font-size: 18px;
  }

  .status-pill {
    border-radius: 999px;
    padding: 4px 9px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .status-ok { background: #d1e7dd; color: #0f5132; }
  .status-warning { background: #fff3cd; color: #664d03; }
  .status-error { background: #f8d7da; color: #842029; }
  .status-info { background: #cff4fc; color: #055160; }

  .check-summary {
    color: #343a40;
    margin-bottom: 8px;
  }

  .check-details {
    margin: 0;
    padding-left: 18px;
    color: #586069;
    font-size: 13px;
  }

  .empty-state {
    border: 1px dashed #adb5bd;
    border-radius: 8px;
    padding: 28px;
    text-align: center;
    color: #586069;
    background: #fff;
  }

  .advanced-panel {
    display: none;
    margin-top: 20px;
  }

  .advanced-panel h2,
  .security-panel h2 {
    margin-bottom: 6px;
  }

  .advanced-panel > p,
  .security-panel > p {
    color: #586069;
    margin-bottom: 14px;
  }

  .advanced-grid,
  .security-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .advanced-card,
  .security-card {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
    padding: 14px;
  }

  .advanced-card h3,
  .security-card h3 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .advanced-card p,
  .security-card p {
    min-height: 42px;
    color: #586069;
    margin-bottom: 10px;
  }

  .advanced-card button,
  .security-card button {
    border: 1px solid #0d6efd;
    border-radius: 6px;
    padding: 7px 12px;
    background: #fff;
    color: #0d6efd;
    font-weight: 600;
  }

  .advanced-card button:disabled,
  .security-card button:disabled {
    opacity: 0.6;
  }

  .security-card.safe button {
    border-color: #198754;
    color: #198754;
  }

  .security-card.audit button {
    border-color: #6f42c1;
    color: #6f42c1;
  }

  .advanced-output,
  .security-output {
    display: none;
    margin-top: 10px;
    border-radius: 6px;
    background: #111827;
    color: #f8f9fa;
    padding: 10px;
    max-height: 260px;
    overflow: auto;
    white-space: pre-wrap;
    font-family: Consolas, monospace;
    font-size: 12px;
  }

  .asr-manager {
    margin-top: 14px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
    padding: 14px;
  }

  .asr-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .asr-toolbar h3 {
    margin: 0;
    font-size: 18px;
  }

  .asr-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .asr-actions button {
    border: 1px solid #0d6efd;
    border-radius: 6px;
    padding: 7px 12px;
    background: #fff;
    color: #0d6efd;
    font-weight: 600;
  }

  .asr-table {
    width: 100%;
    border-collapse: collapse;
  }

  .asr-table th,
  .asr-table td {
    border-top: 1px solid #edf0f2;
    padding: 9px;
    vertical-align: middle;
  }

  .asr-table th {
    color: #586069;
    font-size: 12px;
    text-transform: uppercase;
  }

  .asr-table select {
    min-width: 96px;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 6px;
    background: #fff;
  }

  .asr-history {
    margin-top: 14px;
  }

  .asr-history-list {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .asr-event {
    border: 1px solid #edf0f2;
    border-radius: 6px;
    padding: 9px;
    background: #f8f9fa;
    font-size: 13px;
  }

  .asr-event strong {
    display: block;
    margin-bottom: 4px;
  }

  @media (max-width: 900px) {
    .summary-row,
    .checks-grid,
    .advanced-grid,
    .security-grid {
      grid-template-columns: 1fr;
    }

    .integrity-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<div class="integrity-shell">
  <div class="integrity-header">
    <div>
      <h2>Diagnostic d'integrite Windows</h2>
      <p>Verifie antivirus, Defender, pare-feu, services systeme, disque, BitLocker, redemarrage et historique Windows Update.</p>
    </div>
    <button id="scanButton" class="scan-button">Lancer les checks</button>
  </div>

  <div id="summary" class="summary-row" style="display: none;"></div>
  <div id="results" class="checks-grid">
    <div class="empty-state">Clique sur le bouton pour lancer un diagnostic complet en lecture seule.</div>
  </div>

  <div id="advancedPanel" class="advanced-panel">
    <h2>Checks pousses</h2>
    <p>Ces actions sont plus longues. Les reparations systeme demandent l'UAC et peuvent prendre plusieurs minutes.</p>
    <div id="advancedGrid" class="advanced-grid"></div>
  </div>

  <div id="securityPanel" class="security-panel">
    <h2>Securite du poste</h2>
    <p>Actions progressives pour renforcer Windows sans passer brutalement en mode blocage. Les changements sensibles commencent en audit ou diagnostic.</p>
    <div id="securityGrid" class="security-grid"></div>
    <div class="asr-manager">
      <div class="asr-toolbar">
        <h3>Regles ASR Microsoft Defender</h3>
        <div class="asr-actions">
          <button id="asrDefaultButton">Default</button>
          <button id="asrRefreshButton">Actualiser</button>
          <button id="asrApplyButton">Appliquer avec UAC</button>
        </div>
      </div>
      <div id="asrStatus" class="check-summary">Chargement des regles ASR...</div>
      <div id="asrRulesContainer"></div>
      <div class="asr-history">
        <div class="asr-toolbar">
          <h3>Historique ASR</h3>
          <div class="asr-actions">
            <button id="asrHistoryButton">Actualiser l'historique</button>
          </div>
        </div>
        <div id="asrHistoryList" class="asr-history-list">
          <div class="empty-state">Les detections audit/block apparaitront ici pendant que Defender les journalise.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const scanButton = document.getElementById('scanButton');
  const summary = document.getElementById('summary');
  const results = document.getElementById('results');
  const advancedPanel = document.getElementById('advancedPanel');
  const advancedGrid = document.getElementById('advancedGrid');
  const securityGrid = document.getElementById('securityGrid');
  const asrStatus = document.getElementById('asrStatus');
  const asrRulesContainer = document.getElementById('asrRulesContainer');
  const asrDefaultButton = document.getElementById('asrDefaultButton');
  const asrRefreshButton = document.getElementById('asrRefreshButton');
  const asrApplyButton = document.getElementById('asrApplyButton');
  const asrHistoryButton = document.getElementById('asrHistoryButton');
  const asrHistoryList = document.getElementById('asrHistoryList');
  let asrRules = [];
  let asrDefaults = {};

  const labels = {
    ok: 'OK',
    warning: 'Attention',
    error: 'Erreur',
    info: 'Info',
  };

  const advancedChecks = [
    {
      id: 'defender-signature-update',
      title: 'MAJ signatures Defender',
      description: 'Force une mise a jour des signatures antivirus Microsoft Defender.',
      admin: false,
    },
    {
      id: 'defender-quick-scan',
      title: 'Scan rapide Defender',
      description: 'Lance un scan antivirus rapide via Microsoft Defender.',
      admin: false,
    },
    {
      id: 'sfc-verifyonly',
      title: 'SFC verification',
      description: 'Verifie les fichiers systeme sans tenter de reparation.',
      admin: true,
    },
    {
      id: 'sfc-scannow',
      title: 'SFC /scannow',
      description: 'Verifie et repare les fichiers systeme Windows.',
      admin: true,
    },
    {
      id: 'dism-checkhealth',
      title: 'DISM CheckHealth',
      description: "Verification rapide de l'image Windows.",
      admin: true,
    },
    {
      id: 'dism-scanhealth',
      title: 'DISM ScanHealth',
      description: "Analyse approfondie de l'image Windows.",
      admin: true,
    },
    {
      id: 'dism-restorehealth',
      title: 'DISM RestoreHealth',
      description: "Repare l'image Windows via Windows Update si necessaire.",
      admin: true,
    },
    {
      id: 'dism-analyze-component-store',
      title: 'Analyse component store',
      description: 'Verifie si le magasin WinSxS peut etre nettoye.',
      admin: true,
    },
    {
      id: 'chkdsk-scan',
      title: 'CHKDSK /scan',
      description: 'Analyse le disque C: en ligne sans redemarrage immediat.',
      admin: true,
    },
    {
      id: 'network-basics',
      title: 'Reseau de base',
      description: 'Verifie IP, DNS et connexion HTTPS vers Microsoft.',
      admin: false,
    },
  ];

  const securityActions = [
    {
      id: 'microsoft-baseline-safe',
      title: 'Baseline Microsoft officielle',
      description: 'Active pare-feu, protections Defender de base, cloud protection, samples sûrs et PUA.',
      tone: 'safe',
    },
    {
      id: 'defender-hardened',
      title: 'Protections Defender renforcees',
      description: 'Renforce Defender avec cloud high, signatures, Network Protection et Controlled Folder Access en audit.',
      tone: 'safe',
    },
    {
      id: 'hardware-security-check',
      title: 'Chiffrement + materiel',
      description: 'Controle TPM, Secure Boot, BitLocker et VBS sans activer de chiffrement automatiquement.',
      tone: 'audit',
    },
  ];

  scanButton.addEventListener('click', () => {
    scanButton.disabled = true;
    scanButton.textContent = 'Analyse en cours...';
    summary.style.display = 'none';
    results.innerHTML = '<div class="empty-state">Analyse en cours, quelques secondes...</div>';
    window.electron.send('run-integrity-check');
  });

  window.electron.on('integrity-result', (result) => {
    scanButton.disabled = false;
    scanButton.textContent = 'Relancer les checks';
    renderSummary(result);
    renderChecks(result.checks || []);
    renderAdvancedChecks();
    renderSecurityActions();
  });

  window.electron.on('integrity-advanced-result', (result) => {
    const button = document.querySelector(`[data-run-advanced="${result.id}"]`);
    const output = document.getElementById(`advanced-output-${result.id}`);
    if (button) {
      const check = advancedChecks.find((item) => item.id === result.id);
      button.disabled = false;
      button.textContent = check && check.admin ? 'Lancer avec UAC' : 'Lancer';
    }

    if (output) {
      const seconds = Math.round((result.durationMs || 0) / 1000);
      output.style.display = 'block';
      output.textContent = `[${labels[result.status] || result.status}] ${result.title}\nCode sortie: ${result.exitCode}\nDuree: ${seconds}s\n\n${result.output || ''}`;
    }
  });

  window.electron.on('security-action-result', (result) => {
    const button = document.querySelector(`[data-run-security="${result.id}"]`);
    const output = document.getElementById(`security-output-${result.id}`);
    if (button) {
      button.disabled = false;
      button.textContent = result.admin ? 'Appliquer avec UAC' : 'Appliquer';
    }

    if (output) {
      const seconds = Math.round((result.durationMs || 0) / 1000);
      output.style.display = 'block';
      output.textContent = `[${labels[result.status] || result.status}] ${result.title}\nCode sortie: ${result.exitCode}\nDuree: ${seconds}s\n\n${result.output || ''}`;
    }
  });

  window.electron.on('asr-state-result', (payload) => {
    asrRules = payload.rules || [];
    asrDefaults = payload.defaults || {};
    asrStatus.textContent = payload.success ? 'Etat ASR actuel charge.' : `Lecture ASR impossible: ${payload.error}`;
    renderAsrRules();
  });

  window.electron.on('asr-rules-result', (payload) => {
    asrApplyButton.disabled = false;
    asrApplyButton.textContent = 'Appliquer avec UAC';
    if (!payload.success) {
      asrStatus.textContent = `Application ASR impossible: ${payload.error}`;
      return;
    }

    asrStatus.textContent = 'Regles ASR appliquees. Les detections audit/block sont surveillees via les evenements Defender.';
    asrRules = payload.result.rules || asrRules;
    renderAsrRules();
    window.electron.send('get-asr-history');
  });

  window.electron.on('asr-history-result', (payload) => {
    renderAsrHistory(payload.events || [], payload.error);
  });

  function renderSummary(result) {
    const total = (result.checks || []).length;
    const ok = (result.checks || []).filter((check) => check.status === 'ok').length;

    summary.style.display = 'grid';
    summary.innerHTML = `
      <div class="summary-box">
        <span>Etat global</span>
        <strong>${labels[result.overall] || result.overall}</strong>
      </div>
      <div class="summary-box">
        <span>Checks OK</span>
        <strong>${ok}/${total}</strong>
      </div>
      <div class="summary-box">
        <span>A surveiller</span>
        <strong>${(result.warnings || 0) + (result.errors || 0)}</strong>
      </div>
    `;
  }

  function renderChecks(checks) {
    if (!checks.length) {
      results.innerHTML = '<div class="empty-state">Aucun resultat retourne.</div>';
      return;
    }

    results.innerHTML = checks.map((check) => {
      const status = check.status || 'info';
      const details = (check.details || []).map((detail) => `<li>${escapeHtml(detail)}</li>`).join('');
      return `
        <div class="check-card">
          <div class="check-title">
            <h3>${escapeHtml(check.title)}</h3>
            <span class="status-pill status-${status}">${labels[status] || status}</span>
          </div>
          <div class="check-summary">${escapeHtml(check.summary || '')}</div>
          ${details ? `<ul class="check-details">${details}</ul>` : ''}
        </div>
      `;
    }).join('');
  }

  function renderAdvancedChecks() {
    advancedPanel.style.display = 'block';
    advancedGrid.innerHTML = advancedChecks.map((check) => `
      <div class="advanced-card">
        <h3>${escapeHtml(check.title)}</h3>
        <p>${escapeHtml(check.description)}${check.admin ? ' UAC requis.' : ''}</p>
        <button data-run-advanced="${check.id}">${check.admin ? 'Lancer avec UAC' : 'Lancer'}</button>
        <pre id="advanced-output-${check.id}" class="advanced-output"></pre>
      </div>
    `).join('');

    document.querySelectorAll('[data-run-advanced]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-run-advanced');
        const output = document.getElementById(`advanced-output-${id}`);
        button.disabled = true;
        button.textContent = 'En cours...';
        output.style.display = 'block';
        output.textContent = 'Execution en cours. Patiente, certains checks peuvent durer longtemps...';
        window.electron.send('run-integrity-advanced-check', id);
      });
    });
  }

  function renderSecurityActions() {
    securityGrid.innerHTML = securityActions.map((action) => `
      <div class="security-card ${action.tone}">
        <h3>${escapeHtml(action.title)}</h3>
        <p>${escapeHtml(action.description)} UAC requis.</p>
        <button data-run-security="${action.id}">Appliquer avec UAC</button>
        <pre id="security-output-${action.id}" class="security-output"></pre>
      </div>
    `).join('');

    document.querySelectorAll('[data-run-security]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-run-security');
        const output = document.getElementById(`security-output-${id}`);
        button.disabled = true;
        button.textContent = 'Application...';
        output.style.display = 'block';
        output.textContent = 'Application en cours. Accepte l UAC si Windows le demande...';
        window.electron.send('run-security-action', id);
      });
    });
  }

  function renderAsrRules() {
    if (!asrRules.length) {
      asrRulesContainer.innerHTML = '<div class="empty-state">Aucune regle ASR chargee.</div>';
      return;
    }

    asrRulesContainer.innerHTML = `
      <table class="asr-table">
        <thead>
          <tr>
            <th>Regle</th>
            <th>Categorie</th>
            <th>Mode</th>
          </tr>
        </thead>
        <tbody>
          ${asrRules.map((rule) => `
            <tr>
              <td>
                <strong>${escapeHtml(rule.title)}</strong><br>
                <small>${escapeHtml(rule.id)}</small>
              </td>
              <td>${escapeHtml(rule.category || '')}</td>
              <td>
                <select data-asr-mode="${rule.id}">
                  <option value="none"${rule.mode === 'none' ? ' selected' : ''}>None</option>
                  <option value="audit"${rule.mode === 'audit' ? ' selected' : ''}>Audit</option>
                  <option value="on"${rule.mode === 'on' ? ' selected' : ''}>On</option>
                </select>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  function collectAsrModes() {
    const modes = {};
    document.querySelectorAll('[data-asr-mode]').forEach((select) => {
      modes[select.getAttribute('data-asr-mode')] = select.value;
    });
    return modes;
  }

  function renderAsrHistory(events, error) {
    if (error) {
      asrHistoryList.innerHTML = `<div class="empty-state">Historique ASR indisponible: ${escapeHtml(error)}</div>`;
      return;
    }

    if (!events.length) {
      asrHistoryList.innerHTML = '<div class="empty-state">Aucune detection ASR recente dans le journal Defender.</div>';
      return;
    }

    asrHistoryList.innerHTML = events.map((event) => `
      <div class="asr-event">
        <strong>${escapeHtml(event.timeCreated)} - Event ${escapeHtml(event.id)}</strong>
        <span>${escapeHtml(event.message || '')}</span>
      </div>
    `).join('');
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  renderSecurityActions();
  window.electron.send('get-asr-state');
  window.electron.send('get-asr-history');

  asrDefaultButton.addEventListener('click', () => {
    asrRules = asrRules.map((rule) => ({
      ...rule,
      mode: asrDefaults[rule.id] || rule.defaultMode || 'audit',
    }));
    asrStatus.textContent = 'Preset Default charge. Clique sur Appliquer avec UAC pour le poser sur Defender.';
    renderAsrRules();
  });

  asrRefreshButton.addEventListener('click', () => {
    asrStatus.textContent = 'Actualisation ASR...';
    window.electron.send('get-asr-state');
  });

  asrApplyButton.addEventListener('click', () => {
    asrApplyButton.disabled = true;
    asrApplyButton.textContent = 'Application...';
    asrStatus.textContent = 'Application des regles ASR en cours. Accepte l UAC si Windows le demande.';
    window.electron.send('set-asr-rules', collectAsrModes());
  });

  asrHistoryButton.addEventListener('click', () => {
    asrHistoryList.innerHTML = '<div class="empty-state">Lecture de l historique ASR...</div>';
    window.electron.send('get-asr-history');
  });
</script>

<%- include('partials/footers') %>
