<%- include('partials/headers', { page_title: "Integrite de votre PC" }) %>

<style>
  .integrity-shell {
    max-width: 1100px;
    margin: 24px auto 48px;
  }

  .integrity-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .integrity-header p {
    margin: 4px 0 0;
    color: #586069;
  }

  .scan-button {
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    background: #0d6efd;
    color: #fff;
    font-weight: 600;
  }

  .scan-button:disabled {
    opacity: 0.65;
  }

  .summary-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .summary-box,
  .check-card {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
  }

  .summary-box {
    padding: 16px;
  }

  .summary-box strong {
    display: block;
    font-size: 24px;
  }

  .checks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .check-card {
    padding: 14px;
  }

  .check-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  .check-title h3 {
    margin: 0;
    font-size: 18px;
  }

  .status-pill {
    border-radius: 999px;
    padding: 4px 9px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .status-ok { background: #d1e7dd; color: #0f5132; }
  .status-warning { background: #fff3cd; color: #664d03; }
  .status-error { background: #f8d7da; color: #842029; }
  .status-info { background: #cff4fc; color: #055160; }

  .check-summary {
    color: #343a40;
    margin-bottom: 8px;
  }

  .check-details {
    margin: 0;
    padding-left: 18px;
    color: #586069;
    font-size: 13px;
  }

  .empty-state {
    border: 1px dashed #adb5bd;
    border-radius: 8px;
    padding: 28px;
    text-align: center;
    color: #586069;
    background: #fff;
  }

  .advanced-panel {
    display: none;
    margin-top: 20px;
  }

  .advanced-panel h2,
  .security-panel h2 {
    margin-bottom: 6px;
  }

  .advanced-panel > p,
  .security-panel > p {
    color: #586069;
    margin-bottom: 14px;
  }

  .advanced-grid,
  .security-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .advanced-card,
  .security-card {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
    padding: 14px;
  }

  .advanced-card h3,
  .security-card h3 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .advanced-card p,
  .security-card p {
    min-height: 42px;
    color: #586069;
    margin-bottom: 10px;
  }

  .advanced-card button,
  .security-card button {
    border: 1px solid #0d6efd;
    border-radius: 6px;
    padding: 7px 12px;
    background: #fff;
    color: #0d6efd;
    font-weight: 600;
  }

  .advanced-card button:disabled,
  .security-card button:disabled {
    opacity: 0.6;
  }

  .security-card.safe button {
    border-color: #198754;
    color: #198754;
  }

  .security-card.audit button {
    border-color: #6f42c1;
    color: #6f42c1;
  }

  .security-notice {
    margin: 0 0 14px;
    padding: 12px 14px;
    border: 1px solid #b6d4fe;
    border-radius: 8px;
    background: #e7f1ff;
    color: #084298;
    font-size: 13px;
  }

  .security-meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .security-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 999px;
    background: #e9ecef;
    color: #495057;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .security-badge.read-only {
    background: #e2d9f3;
    color: #432874;
  }

  .security-impact {
    min-height: 78px;
    margin: 0 0 12px;
    padding-left: 18px;
    color: #495057;
    font-size: 13px;
  }

  .security-impact li {
    margin-bottom: 4px;
  }

  .security-card .safety-note {
    min-height: 0;
    margin: 0 0 12px;
    padding: 8px 10px;
    border-left: 3px solid #198754;
    background: #f1f8f4;
    color: #355b45;
    font-size: 12px;
  }

  .security-button-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .security-card .secondary-action {
    border-color: #6c757d;
    color: #495057;
  }

  .advanced-output,
  .security-output {
    display: none;
    margin-top: 10px;
    border-radius: 6px;
    background: #111827;
    color: #f8f9fa;
    padding: 10px;
    max-height: 260px;
    overflow: auto;
    white-space: pre-wrap;
    font-family: Consolas, monospace;
    font-size: 12px;
  }

  .asr-manager {
    margin-top: 14px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background: #fff;
    padding: 14px;
  }

  .asr-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .asr-toolbar h3 {
    margin: 0;
    font-size: 18px;
  }

  .asr-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .asr-actions button {
    border: 1px solid #0d6efd;
    border-radius: 6px;
    padding: 7px 12px;
    background: #fff;
    color: #0d6efd;
    font-weight: 600;
  }

  .asr-table {
    width: 100%;
    border-collapse: collapse;
  }

  .asr-table th,
  .asr-table td {
    border-top: 1px solid #edf0f2;
    padding: 9px;
    vertical-align: middle;
  }

  .asr-table th {
    color: #586069;
    font-size: 12px;
    text-transform: uppercase;
  }

  .asr-table select {
    min-width: 96px;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 6px;
    background: #fff;
  }

  .asr-history {
    margin-top: 14px;
  }

  .asr-history-list {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .asr-event {
    border: 1px solid #edf0f2;
    border-radius: 6px;
    padding: 9px;
    background: #f8f9fa;
    font-size: 13px;
  }

  .asr-event strong {
    display: block;
    margin-bottom: 4px;
  }

  @media (max-width: 900px) {
    .summary-row,
    .checks-grid,
    .advanced-grid,
    .security-grid {
      grid-template-columns: 1fr;
    }

    .integrity-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<div class="integrity-shell">
  <div class="integrity-header">
    <div>
      <h2>Diagnostic d'integrite Windows</h2>
      <p>Verifie antivirus, Defender, pare-feu, services systeme, disque, BitLocker, redemarrage et historique Windows Update.</p>
    </div>
    <button id="scanButton" class="scan-button">Lancer les checks</button>
  </div>

  <div id="summary" class="summary-row" style="display: none;"></div>
  <div id="results" class="checks-grid">
    <div class="empty-state">Clique sur le bouton pour lancer un diagnostic complet en lecture seule.</div>
  </div>

  <div id="advancedPanel" class="advanced-panel">
    <h2>Checks pousses</h2>
    <p>Ces actions sont plus longues. Les reparations systeme demandent l'UAC et peuvent prendre plusieurs minutes.</p>
    <div id="advancedGrid" class="advanced-grid"></div>
  </div>

  <div id="securityPanel" class="security-panel">
    <h2>Securite du poste</h2>
    <p>Des protections adaptees a un PC personnel, avec des choix simples et une verification apres chaque changement.</p>
    <div class="security-notice">
      Le mode recommande active les protections essentielles sans couper les logiciels, les jeux, les partages ou les peripheriques deja utilises.
    </div>
    <div id="securityGrid" class="security-grid"></div>
    <div class="asr-manager">
      <div class="asr-toolbar">
        <h3>Protections anti-attaque Defender</h3>
        <div class="asr-actions">
          <button id="asrDefaultButton">Reglages recommandes</button>
          <button id="asrRefreshButton">Actualiser</button>
          <button id="asrApplyButton">Appliquer avec UAC</button>
        </div>
      </div>
      <div id="asrStatus" class="check-summary">Lecture des protections actuelles sans modifier le PC...</div>
      <pre id="asrResultOutput" class="security-output"></pre>
      <div id="asrRulesContainer"></div>
      <div class="asr-history">
        <div class="asr-toolbar">
          <h3>Activite des protections</h3>
          <div class="asr-actions">
            <button id="asrHistoryButton">Actualiser l'historique</button>
          </div>
        </div>
        <div id="asrHistoryList" class="asr-history-list">
          <div class="empty-state">Les comportements suspects detectes ou bloques apparaitront ici.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const scanButton = document.getElementById('scanButton');
  const summary = document.getElementById('summary');
  const results = document.getElementById('results');
  const advancedPanel = document.getElementById('advancedPanel');
  const advancedGrid = document.getElementById('advancedGrid');
  const securityGrid = document.getElementById('securityGrid');
  const asrStatus = document.getElementById('asrStatus');
  const asrRulesContainer = document.getElementById('asrRulesContainer');
  const asrDefaultButton = document.getElementById('asrDefaultButton');
  const asrRefreshButton = document.getElementById('asrRefreshButton');
  const asrApplyButton = document.getElementById('asrApplyButton');
  const asrHistoryButton = document.getElementById('asrHistoryButton');
  const asrHistoryList = document.getElementById('asrHistoryList');
  const asrResultOutput = document.getElementById('asrResultOutput');
  let asrRules = [];
  let asrDefaults = {};

  const labels = {
    ok: 'OK',
    warning: 'Attention',
    error: 'Erreur',
    info: 'Info',
  };

  const advancedChecks = [
    {
      id: 'defender-signature-update',
      title: 'MAJ signatures Defender',
      description: 'Force une mise a jour des signatures antivirus Microsoft Defender.',
      admin: false,
    },
    {
      id: 'defender-quick-scan',
      title: 'Scan rapide Defender',
      description: 'Lance un scan antivirus rapide via Microsoft Defender.',
      admin: false,
    },
    {
      id: 'sfc-verifyonly',
      title: 'SFC verification',
      description: 'Verifie les fichiers systeme sans tenter de reparation.',
      admin: true,
    },
    {
      id: 'sfc-scannow',
      title: 'SFC /scannow',
      description: 'Verifie et repare les fichiers systeme Windows.',
      admin: true,
    },
    {
      id: 'dism-checkhealth',
      title: 'DISM CheckHealth',
      description: "Verification rapide de l'image Windows.",
      admin: true,
    },
    {
      id: 'dism-scanhealth',
      title: 'DISM ScanHealth',
      description: "Analyse approfondie de l'image Windows.",
      admin: true,
    },
    {
      id: 'dism-restorehealth',
      title: 'DISM RestoreHealth',
      description: "Repare l'image Windows via Windows Update si necessaire.",
      admin: true,
    },
    {
      id: 'dism-analyze-component-store',
      title: 'Analyse component store',
      description: 'Verifie si le magasin WinSxS peut etre nettoye.',
      admin: true,
    },
    {
      id: 'chkdsk-scan',
      title: 'CHKDSK /scan',
      description: 'Analyse le disque C: en ligne sans redemarrage immediat.',
      admin: true,
    },
    {
      id: 'network-basics',
      title: 'Reseau de base',
      description: 'Verifie IP, DNS et connexion HTTPS vers Microsoft.',
      admin: false,
    },
  ];

  const securityActions = [
    {
      id: 'microsoft-baseline-safe',
      title: 'Protection Windows recommandee',
      description: 'Active les protections essentielles d un PC personnel puis verifie leur fonctionnement.',
      tone: 'safe',
      kind: 'apply',
      badge: 'Modifie Windows',
      buttonLabel: 'Appliquer avec UAC',
      runningLabel: 'Application...',
      effects: [
        'Pare-feu actif, entrant bloque et sortant autorise',
        'UAC standard et bureau securise',
        'SmartScreen, protection cloud, PUA et analyses Defender',
        'Wi-Fi non modifiable avant connexion et notifications masquees',
        'SMB1, Telnet, TFTP et PowerShell 2 desactives s ils sont presents',
        'Adresse Wi-Fi privee sur les reseaux marques Public',
      ],
      safety: 'Conserve IPv6, SMB2/3, imprimantes, decouverte locale, Bureau a distance, regles pare-feu et exclusions. Le Wi-Fi de la maison reste inchange et l accessibilite reste disponible.',
      confirmation: 'Appliquer la protection Windows recommandee ? Les anciens appareils qui exigent SMB1 peuvent necessiter la restauration de compatibilite.',
      secondaryId: 'recommended-protection-restore',
      secondaryLabel: 'Restaurer compatibilite',
      secondaryRunningLabel: 'Restauration...',
      secondaryConfirmation: 'Reafficher le Wi-Fi et les notifications avant connexion, et reactiver uniquement les anciens composants qu ArtemisStore a desactives ?',
    },
    {
      id: 'defender-hardened',
      title: 'Protection Defender renforcee',
      description: 'Ameliore la detection sans activer de blocage applicatif agressif.',
      tone: 'safe',
      kind: 'apply',
      badge: 'Modifie Defender',
      buttonLabel: 'Renforcer avec UAC',
      runningLabel: 'Configuration...',
      effects: [
        'Protection cloud High avec delai limite a 20 secondes',
        'Supports amovibles, archives et signatures avant scan',
        'Protection reseau et anti-ransomware en surveillance',
      ],
      safety: 'Les exclusions sont preservees. La surveillance repere les menaces sans empecher les logiciels habituels de fonctionner.',
      confirmation: 'Renforcer Microsoft Defender sans activer de blocage agressif ?',
    },
    {
      id: 'hardware-security-check',
      title: 'Chiffrement et materiel',
      description: 'Verification fiable des protections liees au materiel et au disque systeme.',
      tone: 'audit',
      kind: 'audit',
      badge: 'Verification seule',
      buttonLabel: 'Verifier avec UAC',
      runningLabel: 'Verification...',
      effects: [
        'TPM, Secure Boot et capacites DMA',
        'BitLocker, methode, progression et types de protecteurs',
        'VBS, Credential Guard et integrite de la memoire',
      ],
      safety: 'N active jamais BitLocker, VBS, le firmware ou l integrite memoire automatiquement et n affiche aucune cle de recuperation.',
    },
  ];

  scanButton.addEventListener('click', () => {
    scanButton.disabled = true;
    scanButton.textContent = 'Analyse en cours...';
    summary.style.display = 'none';
    results.innerHTML = '<div class="empty-state">Analyse en cours, quelques secondes...</div>';
    window.electron.send('run-integrity-check');
  });

  window.electron.on('integrity-result', (result) => {
    scanButton.disabled = false;
    scanButton.textContent = 'Relancer les checks';
    renderSummary(result);
    renderChecks(result.checks || []);
    renderAdvancedChecks();
    renderSecurityActions();
  });

  window.electron.on('integrity-advanced-result', (result) => {
    const button = document.querySelector(`[data-run-advanced="${result.id}"]`);
    const output = document.getElementById(`advanced-output-${result.id}`);
    if (button) {
      const check = advancedChecks.find((item) => item.id === result.id);
      button.disabled = false;
      button.textContent = check && check.admin ? 'Lancer avec UAC' : 'Lancer';
    }

    if (output) {
      const seconds = Math.round((result.durationMs || 0) / 1000);
      output.style.display = 'block';
      output.textContent = `[${labels[result.status] || result.status}] ${result.title}\nCode sortie: ${result.exitCode}\nDuree: ${seconds}s\n\n${result.output || ''}`;
    }
  });

  window.electron.on('security-action-result', (result) => {
    const button = document.querySelector(`[data-run-security="${result.id}"]`);
    const output = document.getElementById(`security-output-${result.id}`);
    const action = securityActions.find((item) => item.id === result.id || item.secondaryId === result.id);
    const isSecondary = action && action.secondaryId === result.id;
    if (button) {
      button.disabled = false;
      button.textContent = action
        ? (isSecondary ? action.secondaryLabel : action.buttonLabel)
        : (result.admin ? 'Appliquer avec UAC' : 'Appliquer');
    }

    if (output) {
      const seconds = Math.round((result.durationMs || 0) / 1000);
      output.style.display = 'block';
      const nextStep = action && action.kind === 'apply'
        ? '\n\nRelance le diagnostic principal pour actualiser la vue globale.'
        : '';
      output.textContent = `[${labels[result.status] || result.status}] ${result.title}\nCode sortie: ${result.exitCode}\nDuree: ${seconds}s\n\n${result.output || ''}${nextStep}`;
    }
  });

  window.electron.on('asr-state-result', (payload) => {
    asrRules = payload.rules || [];
    asrDefaults = payload.defaults || {};
    asrStatus.textContent = payload.success ? 'Protections Defender actuelles chargees.' : `Lecture impossible: ${payload.error}`;
    renderAsrRules();
  });

  window.electron.on('asr-rules-result', (payload) => {
    asrApplyButton.disabled = false;
    asrApplyButton.textContent = 'Appliquer avec UAC';
    if (!payload.success) {
      asrStatus.textContent = `Application impossible: ${payload.error}`;
      asrResultOutput.style.display = 'block';
      asrResultOutput.textContent = payload.error || 'Erreur inconnue.';
      return;
    }

    const resultLabel = labels[payload.result.status] || payload.result.status;
    asrStatus.textContent = `${resultLabel}: protections relues apres application. Les reglages deja presents ont ete conserves.`;
    asrResultOutput.style.display = 'block';
    asrResultOutput.textContent = payload.result.output || 'Application terminee sans sortie.';
    asrRules = payload.result.rules || asrRules;
    renderAsrRules();
    window.electron.send('get-asr-history');
  });

  window.electron.on('asr-history-result', (payload) => {
    renderAsrHistory(payload.events || [], payload.error);
  });

  function renderSummary(result) {
    const total = (result.checks || []).length;
    const ok = (result.checks || []).filter((check) => check.status === 'ok').length;

    summary.style.display = 'grid';
    summary.innerHTML = `
      <div class="summary-box">
        <span>Etat global</span>
        <strong>${labels[result.overall] || result.overall}</strong>
      </div>
      <div class="summary-box">
        <span>Checks OK</span>
        <strong>${ok}/${total}</strong>
      </div>
      <div class="summary-box">
        <span>A surveiller</span>
        <strong>${(result.warnings || 0) + (result.errors || 0)}</strong>
      </div>
    `;
  }

  function renderChecks(checks) {
    if (!checks.length) {
      results.innerHTML = '<div class="empty-state">Aucun resultat retourne.</div>';
      return;
    }

    results.innerHTML = checks.map((check) => {
      const status = check.status || 'info';
      const details = (check.details || []).map((detail) => `<li>${escapeHtml(detail)}</li>`).join('');
      return `
        <div class="check-card">
          <div class="check-title">
            <h3>${escapeHtml(check.title)}</h3>
            <span class="status-pill status-${status}">${labels[status] || status}</span>
          </div>
          <div class="check-summary">${escapeHtml(check.summary || '')}</div>
          ${details ? `<ul class="check-details">${details}</ul>` : ''}
        </div>
      `;
    }).join('');
  }

  function renderAdvancedChecks() {
    advancedPanel.style.display = 'block';
    advancedGrid.innerHTML = advancedChecks.map((check) => `
      <div class="advanced-card">
        <h3>${escapeHtml(check.title)}</h3>
        <p>${escapeHtml(check.description)}${check.admin ? ' UAC requis.' : ''}</p>
        <button data-run-advanced="${check.id}">${check.admin ? 'Lancer avec UAC' : 'Lancer'}</button>
        <pre id="advanced-output-${check.id}" class="advanced-output"></pre>
      </div>
    `).join('');

    document.querySelectorAll('[data-run-advanced]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-run-advanced');
        const output = document.getElementById(`advanced-output-${id}`);
        button.disabled = true;
        button.textContent = 'En cours...';
        output.style.display = 'block';
        output.textContent = 'Execution en cours. Patiente, certains checks peuvent durer longtemps...';
        window.electron.send('run-integrity-advanced-check', id);
      });
    });
  }

  function renderSecurityActions() {
    securityGrid.innerHTML = securityActions.map((action) => `
      <div class="security-card ${action.tone}">
        <div class="security-meta">
          <span class="security-badge${action.kind === 'audit' ? ' read-only' : ''}">${escapeHtml(action.badge)}</span>
          <span class="security-badge">UAC requis</span>
        </div>
        <h3>${escapeHtml(action.title)}</h3>
        <p>${escapeHtml(action.description)}</p>
        <ul class="security-impact">
          ${action.effects.map((effect) => `<li>${escapeHtml(effect)}</li>`).join('')}
        </ul>
        <p class="safety-note">${escapeHtml(action.safety)}</p>
        <div class="security-button-row">
          <button data-run-security="${action.id}">${escapeHtml(action.buttonLabel)}</button>
          ${action.secondaryId ? `<button class="secondary-action" data-run-security="${action.secondaryId}">${escapeHtml(action.secondaryLabel)}</button>` : ''}
        </div>
        <pre id="security-output-${action.id}" class="security-output"></pre>
        ${action.secondaryId ? `<pre id="security-output-${action.secondaryId}" class="security-output"></pre>` : ''}
      </div>
    `).join('');

    document.querySelectorAll('[data-run-security]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-run-security');
        const action = securityActions.find((item) => item.id === id || item.secondaryId === id);
        const isSecondary = action && action.secondaryId === id;
        const confirmation = isSecondary ? action.secondaryConfirmation : action && action.confirmation;
        if (confirmation && !window.confirm(confirmation)) {
          return;
        }
        const output = document.getElementById(`security-output-${id}`);
        button.disabled = true;
        button.textContent = action
          ? (isSecondary ? action.secondaryRunningLabel : action.runningLabel)
          : 'Execution...';
        output.style.display = 'block';
        output.textContent = `${action && action.kind === 'audit' ? 'Verification' : 'Application'} en cours. Accepte l UAC si Windows le demande...`;
        window.electron.send('run-security-action', id);
      });
    });
  }

  function renderAsrRules() {
    if (!asrRules.length) {
      asrRulesContainer.innerHTML = '<div class="empty-state">Aucune protection avancee chargee.</div>';
      return;
    }

    asrRulesContainer.innerHTML = `
      <table class="asr-table">
        <thead>
          <tr>
            <th>Protection</th>
            <th>Categorie</th>
            <th>Mode</th>
          </tr>
        </thead>
        <tbody>
          ${asrRules.map((rule) => `
            <tr>
              <td>
                <strong>${escapeHtml(rule.title)}</strong>
              </td>
              <td>${escapeHtml(rule.category || '')}</td>
              <td>
                <select data-asr-mode="${rule.id}">
                  <option value="none"${rule.mode === 'none' ? ' selected' : ''}>Desactive</option>
                  <option value="audit"${rule.mode === 'audit' ? ' selected' : ''}>Surveiller</option>
                  <option value="warn"${rule.mode === 'warn' ? ' selected' : ''}>Avertir</option>
                  <option value="on"${rule.mode === 'on' ? ' selected' : ''}>Bloquer</option>
                </select>
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  function collectAsrModes() {
    const modes = {};
    document.querySelectorAll('[data-asr-mode]').forEach((select) => {
      modes[select.getAttribute('data-asr-mode')] = select.value;
    });
    return modes;
  }

  function renderAsrHistory(events, error) {
    if (error) {
      asrHistoryList.innerHTML = `<div class="empty-state">Historique des protections indisponible: ${escapeHtml(error)}</div>`;
      return;
    }

    if (!events.length) {
      asrHistoryList.innerHTML = '<div class="empty-state">Aucun comportement suspect recent dans le journal Defender.</div>';
      return;
    }

    asrHistoryList.innerHTML = events.map((event) => `
      <div class="asr-event">
        <strong>${escapeHtml(event.timeCreated)} - Event ${escapeHtml(event.id)}</strong>
        <span>${escapeHtml(event.message || '')}</span>
      </div>
    `).join('');
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  renderSecurityActions();
  window.electron.send('get-asr-state');
  window.electron.send('get-asr-history');

  asrDefaultButton.addEventListener('click', () => {
    asrRules = asrRules.map((rule) => ({
      ...rule,
      mode: asrDefaults[rule.id] || rule.defaultMode || 'audit',
    }));
    asrStatus.textContent = 'Reglages recommandes charges: les pilotes dangereux sont bloques et les autres comportements suspects sont surveilles sans bloquer les logiciels.';
    renderAsrRules();
  });

  asrRefreshButton.addEventListener('click', () => {
    asrStatus.textContent = 'Actualisation des protections...';
    window.electron.send('get-asr-state');
  });

  asrApplyButton.addEventListener('click', () => {
    const modes = collectAsrModes();
    const blockingCount = Object.values(modes).filter((mode) => mode === 'on').length;
    if (blockingCount > 0 && !window.confirm(`${blockingCount} protection(s) seront en mode Bloquer. Les reglages Defender deja presents seront conserves. Continuer ?`)) {
      return;
    }
    asrApplyButton.disabled = true;
    asrApplyButton.textContent = 'Application...';
    asrStatus.textContent = 'Application des protections en cours. Accepte l UAC si Windows le demande.';
    asrResultOutput.style.display = 'block';
    asrResultOutput.textContent = 'Application et verification des protections en cours...';
    window.electron.send('set-asr-rules', modes);
  });

  asrHistoryButton.addEventListener('click', () => {
    asrHistoryList.innerHTML = '<div class="empty-state">Lecture de l activite des protections...</div>';
    window.electron.send('get-asr-history');
  });
</script>

<%- include('partials/footers') %>
