<%- include('partials/headers', {page_title: "Windows et Office"}) %>

<style>
    .license-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 18px;
    }

    .license-section,
    .action-container,
    .advanced-container {
        margin-bottom: 22px;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .license-section h2,
    .action-container h3,
    .advanced-container h3 {
        margin: 0 0 16px;
        color: #111827;
        font-size: 1.2rem;
        font-weight: 750;
    }

    .license-status {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 18px;
        padding: 14px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f8fafc;
    }

    .license-status-dot {
        width: 13px;
        height: 13px;
        flex: 0 0 13px;
        border-radius: 50%;
        background: #94a3b8;
        box-shadow: 0 0 0 5px rgba(148, 163, 184, 0.14);
    }

    .license-status.success .license-status-dot {
        background: #16a34a;
        box-shadow: 0 0 0 5px rgba(22, 163, 74, 0.14);
    }

    .license-status.warning .license-status-dot {
        background: #d97706;
        box-shadow: 0 0 0 5px rgba(217, 119, 6, 0.14);
    }

    .license-status.danger .license-status-dot {
        background: #dc2626;
        box-shadow: 0 0 0 5px rgba(220, 38, 38, 0.14);
    }

    .license-status strong,
    .license-status span {
        display: block;
    }

    .license-status span {
        margin-top: 2px;
        color: #64748b;
        font-size: 0.9rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px;
    }

    .info-item,
    .license-detail {
        padding: 13px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
    }

    .info-item span,
    .license-detail span {
        display: block;
        margin-bottom: 4px;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .info-item strong,
    .license-detail strong {
        color: #1f2937;
        overflow-wrap: anywhere;
    }

    .license-list {
        display: grid;
        gap: 10px;
        margin-top: 16px;
    }

    .license-detail {
        border-left: 4px solid #94a3b8;
    }

    .license-detail.success {
        border-left-color: #16a34a;
    }

    .license-detail.warning {
        border-left-color: #d97706;
    }

    .license-detail.danger {
        border-left-color: #dc2626;
    }

    .license-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 9px 16px;
        margin-top: 10px;
    }

    .license-detail-grid p {
        margin: 0;
        color: #4b5563;
        font-size: 0.9rem;
    }

    .diagnostic-note {
        margin: 14px 0 0;
        padding: 10px 12px;
        border-radius: 9px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 0.88rem;
    }

    .action-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 18px;
    }

    .action-box {
        padding: 15px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
    }

    .action-box h4 {
        margin: 0 0 12px;
        font-size: 1rem;
    }

    .action-box .d-flex {
        gap: 8px;
    }

    .advanced-warning {
        color: #9a3412;
    }

    .advanced-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 8px;
    }

    .btn-advanced {
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        color: #334155;
    }

    .loading-card {
        color: #64748b;
    }
</style>

<div class="license-toolbar">
    <button class="btn btn-primary" id="refresh-info">Actualiser les informations</button>
</div>

<section class="license-section">
    <h2>Licence Windows</h2>
    <div id="win-office-info" class="loading-card">
        Lecture de Windows et de sa licence...
    </div>
</section>

<section class="license-section">
    <h2>Licence Microsoft Office</h2>
    <div id="office-info" class="loading-card">
        Recherche d Office et de ses licences...
    </div>
</section>

<section class="action-container">
    <h3>Actions Windows et Office</h3>
    <div class="action-row">
        <div class="action-box">
            <h4>Changer la version de Windows</h4>
            <div class="d-flex">
                <select class="form-select" id="change-version">
                    <option value="" selected>Choisir une version</option>
                    <option value="home">Windows Home</option>
                    <option value="pro">Windows Pro</option>
                    <option value="enterprise">Windows Enterprise</option>
                </select>
                <button class="btn btn-success" id="apply-version" disabled>Appliquer</button>
            </div>
        </div>
        <div class="action-box">
            <h4>Microsoft Office</h4>
            <div class="d-flex flex-wrap">
                <button class="btn btn-primary license-action" id="download-office" disabled>Telecharger Office</button>
                <button class="btn btn-success license-action" id="activate-office" disabled>Activer Office</button>
            </div>
        </div>
    </div>
</section>

<section class="advanced-container">
    <h3>Options avancees</h3>
    <p class="advanced-warning"><strong>Attention :</strong> ces actions peuvent modifier les licences. Elles ne sont pas lancees par la simple verification ci-dessus.</p>
    <div id="advanced-buttons" class="advanced-buttons"></div>
</section>

<script>
    const licenseStateLabels = {
        Licensed: 'Activee',
        Unlicensed: 'Non activee',
        InitialGrace: 'Periode d essai',
        AdditionalGrace: 'Delai supplementaire',
        NonGenuineGrace: 'Licence non authentique',
        Notification: 'Action necessaire',
        ExtendedGrace: 'Delai etendu',
        Grace: 'Periode de grace',
        RFM: 'Expiree ou fonctionnalites reduites',
        Unknown: 'Etat inconnu',
    };

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function safeList(value) {
        return Array.isArray(value) ? value : [];
    }

    function licenseTone(state) {
        if (state === 'Licensed') return 'success';
        if (['InitialGrace', 'AdditionalGrace', 'ExtendedGrace', 'Grace'].includes(state)) {
            return 'warning';
        }
        if (['Unlicensed', 'NonGenuineGrace', 'Notification', 'RFM'].includes(state)) {
            return 'danger';
        }
        return '';
    }

    function licenseLabel(state) {
        return licenseStateLabels[state] || state || licenseStateLabels.Unknown;
    }

    function formatDate(value) {
        if (!value) return null;
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? null : date.toLocaleString('fr-FR');
    }

    function renderDiagnostics(diagnostics) {
        const messages = safeList(diagnostics).filter(Boolean);
        if (!messages.length) return '';
        return `<p class="diagnostic-note">${messages.map(escapeHtml).join('<br>')}</p>`;
    }

    function renderWindows(data) {
        const container = document.getElementById('win-office-info');
        const state = data.osLicenseStatus || 'Unknown';
        const licensed = data.osActivationStatus === true;
        const stateTone = licensed ? 'success' : licenseTone(state) || 'warning';
        const partialKey = data.osPartialProductKey
            ? `Cle terminee par ${escapeHtml(data.osPartialProductKey)}`
            : 'Cle partielle indisponible';

        container.innerHTML = `
            <div class="license-status ${stateTone}">
                <span class="license-status-dot" aria-hidden="true"></span>
                <div>
                    <strong>${licensed ? 'Windows est active' : 'Windows n est pas active ou son etat est inconnu'}</strong>
                    <span>${escapeHtml(licenseLabel(state))} - ${escapeHtml(data.osActivationType || 'Canal inconnu')} - ${partialKey}</span>
                </div>
            </div>
            <div class="info-grid">
                <div class="info-item"><span>Systeme</span><strong>${escapeHtml(data.osName)}</strong></div>
                <div class="info-item"><span>Edition</span><strong>${escapeHtml(data.windowsEditionId)}</strong></div>
                <div class="info-item"><span>Version</span><strong>${escapeHtml(data.osDisplayVersion)}</strong></div>
                <div class="info-item"><span>Architecture</span><strong>${escapeHtml(data.osArchitecture || data.osVersion)}</strong></div>
            </div>
            ${renderDiagnostics(data.windowsDiagnostics)}
        `;
    }

    function renderOfficeLicense(license) {
        const state = license.LicenseState || 'Unknown';
        const expiry = formatDate(license.NotAfter);
        const renewal = formatDate(license.NextRenewal);
        return `
            <article class="license-detail ${licenseTone(state)}">
                <span>Produit</span>
                <strong>${escapeHtml(license.Product || 'Microsoft Office')}</strong>
                <div class="license-detail-grid">
                    <p><b>Etat :</b> ${escapeHtml(licenseLabel(state))}</p>
                    <p><b>Type :</b> ${escapeHtml(license.LicenseType || 'Inconnu')}</p>
                    ${license.PartialProductKey ? `<p><b>Cle :</b> ...${escapeHtml(license.PartialProductKey)}</p>` : ''}
                    ${expiry ? `<p><b>Valable jusqu au :</b> ${escapeHtml(expiry)}</p>` : ''}
                    ${renewal ? `<p><b>Renouvellement :</b> ${escapeHtml(renewal)}</p>` : ''}
                    ${license.EntitlementStatus ? `<p><b>Abonnement :</b> ${escapeHtml(license.EntitlementStatus)}</p>` : ''}
                </div>
            </article>
        `;
    }

    function renderOffice(data) {
        const container = document.getElementById('office-info');
        if (!data.officeInstalled) {
            container.innerHTML = `
                <div class="license-status">
                    <span class="license-status-dot" aria-hidden="true"></span>
                    <div>
                        <strong>Microsoft Office non detecte</strong>
                        <span>Aucune installation Office classique ou Microsoft 365 trouvee.</span>
                    </div>
                </div>
                ${renderDiagnostics(data.officeDiagnostics)}
            `;
            return;
        }

        const licenses = safeList(data.officeLicenses);
        const activated = data.officeActivated === true;
        const productIds = safeList(data.officeProductIds);
        const applications = safeList(data.officeApps);
        const statusTone = activated ? 'success' : licenses.length ? 'danger' : 'warning';
        const statusText = activated
            ? 'Une licence Office active a ete detectee'
            : licenses.length
              ? 'Aucune des licences Office detectees n est active'
              : 'Office est installe, mais aucune licence lisible n a ete trouvee';

        container.innerHTML = `
            <div class="license-status ${statusTone}">
                <span class="license-status-dot" aria-hidden="true"></span>
                <div>
                    <strong>${statusText}</strong>
                    <span>${escapeHtml(data.officeVersion || 'Version inconnue')}${data.officePlatform ? ` - ${escapeHtml(data.officePlatform)}` : ''}</span>
                </div>
            </div>
            <div class="info-grid">
                <div class="info-item"><span>Produit</span><strong>${escapeHtml(productIds.join(', ') || 'Microsoft Office')}</strong></div>
                <div class="info-item"><span>Applications</span><strong>${escapeHtml(applications.join(', ') || 'Installation detectee')}</strong></div>
                <div class="info-item"><span>Licences trouvees</span><strong>${licenses.length}</strong></div>
            </div>
            ${licenses.length ? `<div class="license-list">${licenses.map(renderOfficeLicense).join('')}</div>` : ''}
            ${renderDiagnostics(data.officeDiagnostics)}
        `;
    }

    function renderInfo(data) {
        if (!data || data.dataAvailable === false) {
            const errorMessage = renderDiagnostics(
                data
                    ? [...safeList(data.windowsDiagnostics), ...safeList(data.officeDiagnostics)]
                    : ['Informations indisponibles.']
            );
            document.getElementById('win-office-info').innerHTML = errorMessage;
            document.getElementById('office-info').innerHTML = errorMessage;
            return;
        }

        renderWindows(data);
        renderOffice(data);
        document.getElementById('download-office').disabled = false;
        document.getElementById('activate-office').disabled = !data.officeInstalled;
    }

    function setLoading() {
        document.getElementById('win-office-info').innerHTML =
            '<p class="loading-card">Lecture de Windows et de sa licence...</p>';
        document.getElementById('office-info').innerHTML =
            '<p class="loading-card">Recherche d Office et de ses licences...</p>';
        document.getElementById('refresh-info').disabled = true;
    }

    document.addEventListener('DOMContentLoaded', () => {
        window.electron.on('win-office-info', (data) => {
            document.getElementById('refresh-info').disabled = false;
            renderInfo(data);
        });

        document.getElementById('refresh-info').addEventListener('click', () => {
            setLoading();
            window.electron.send('refresh-win-office-info');
        });

        document.getElementById('change-version').addEventListener('change', (event) => {
            document.getElementById('apply-version').disabled = !event.target.value;
        });

        document.getElementById('apply-version').addEventListener('click', () => {
            const selectedVersion = document.getElementById('change-version').value;
            if (selectedVersion) {
                window.alert(`Changement de Windows vers ${selectedVersion}`);
            }
        });

        document.getElementById('download-office').addEventListener('click', () => {
            window.electron.send('download-office');
        });

        window.electron.on('office-download-progress', (message) => {
            document.getElementById('office-info').innerHTML = `<p>${escapeHtml(message)}</p>`;
        });

        window.electron.on('office-download-complete', (message) => {
            document.getElementById('office-info').innerHTML = `<p>${escapeHtml(message)}</p>`;
            window.electron.send('refresh-win-office-info');
        });

        document.getElementById('activate-office').addEventListener('click', () => {
            document.getElementById('office-info').innerHTML =
                '<p>Activation de Microsoft Office en cours...</p>';
            window.electron.send('activate-office');
        });

        window.electron.on('office-activation-status', (message) => {
            document.getElementById('office-info').innerHTML = `<p>${escapeHtml(message)}</p>`;
        });

        const advancedButtons = [
            'Check_Activation_Status',
            'Change_Office_Edition',
            'Change_Windows_Edition',
            'Extract_OEM_Folder',
            'HWID_Activation',
            'KMS38_Activation',
            'Ohook_Activation_AIO',
            'Online_KMS_Activation',
            'TSforge_Activation',
            'MAS_AIO',
        ];
        const advancedContainer = document.getElementById('advanced-buttons');
        advancedButtons.forEach((name) => {
            const button = document.createElement('button');
            button.textContent = `Demarrer ${name}.cmd`;
            button.className = 'btn btn-advanced';
            button.addEventListener('click', () => {
                window.electron.send('start-script', `${name}.cmd`);
            });
            advancedContainer.appendChild(button);
        });
    });
</script>

<%- include('partials/footers') %>
